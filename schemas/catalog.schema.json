{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracen Level Catalog v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "levels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "file", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
