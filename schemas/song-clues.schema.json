{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Individually authored maimai clues",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["songId", "sourceFacts", "clues"],
        "properties": {
          "songId": { "type": "integer", "minimum": 1 },
          "clues": { "$ref": "./level.schema.json#/$defs/localized" },
          "sourceFacts": {
            "type": "object", "additionalProperties": false,
            "required": ["title", "artist", "aliases"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "artist": { "type": "string", "minLength": 1 },
              "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "bpm": { "type": "number", "exclusiveMinimum": 0 },
              "charts": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["type", "difficulty", "level"],
                  "properties": {
                    "type": { "enum": ["standard", "dx"] },
                    "difficulty": { "type": "integer", "minimum": 0, "maximum": 4 },
                    "level": { "type": "string", "pattern": "^\\d{1,2}\\+?$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
