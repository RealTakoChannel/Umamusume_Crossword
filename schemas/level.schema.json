{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracen Crossword Level v1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "description", "difficulty", "answerLanguage", "grid", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "difficulty": { "enum": ["beginner", "advanced", "epithets", "cinderella"] },
    "answerLanguage": { "enum": ["en", "ja"] },
    "grid": {
      "type": "object", "required": ["rows", "columns", "layout"], "additionalProperties": false,
      "properties": {
        "rows": { "type": "integer", "minimum": 1, "maximum": 60 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 60 },
        "layout": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[.#]+$" } }
      }
    },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "number", "direction", "row", "column", "characterId", "answer", "clues"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 1 },
          "direction": { "enum": ["across", "down"] },
          "row": { "type": "integer", "minimum": 0 },
          "column": { "type": "integer", "minimum": 0 },
          "characterId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "answer": { "type": "string", "minLength": 2 },
          "clues": { "$ref": "#/$defs/localized" }
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object", "required": ["zh-CN", "en", "ja"], "additionalProperties": false,
      "properties": { "zh-CN": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 }, "ja": { "type": "string", "minLength": 1 } }
    }
  }
}
