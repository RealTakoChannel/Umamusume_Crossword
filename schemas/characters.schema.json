{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tracen Character Dictionary v1",
  "type": "object", "required": ["schemaVersion", "characters"], "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 }, "source": { "type": "string" },
    "characters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "names", "aliases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "names": { "$ref": "level.schema.json#/$defs/localized" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" }
        }
      }
    }
  }
}
